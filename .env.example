# ============================================================================
# STEPUP STORIES — Environment Variables Template (.env.example)
# Copy this file to `.env.local` and fill in your real credentials.
# Never commit `.env` or `.env.local` to version control.
# ============================================================================

# 1. PUBLIC SITE URL (Used for canonical URLs, Open Graph, Sitemap & Unsubscribe links)
NEXT_PUBLIC_SITE_URL=https://stepup-stories.vercel.app

# 2. SUPABASE CONFIGURATION (Postgres Database, Auth & Storage)
# Public values safe for browser client:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key (Used ONLY in server routes/actions & seed scripts; NEVER expose to client):
SUPABASE_SERVICE_ROLE_KEY=

# 3. INITIAL ADMIN & ACCESS CONTROL (Used by `npm run seed:admin` & server-side admin verification)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
APPROVED_ADMIN_EMAILS=
ADMIN_SESSION_SECRET=

# 4. SPAM PROTECTION — CLOUDFLARE TURNSTILE
# Leave blank during local development to use automatic dev pass-through, or set test keys:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 5. SERVER-SIDE EMAIL & PUSH NOTIFICATIONS (Resend API / Webhooks)
# Alerts are sent ONLY when these variables are configured on the server:
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONCIERGE_NOTIFICATION_EMAIL=
ADMIN_ALERT_EMAIL=
ADMIN_PUSH_WEBHOOK_URL=
CUSTOMER_NOTIFICATION_WEBHOOK_URL=

# 6. RAZORPAY ONLINE PAYMENTS (Server-only secret; NEVER put RAZORPAY_KEY_SECRET in client code)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
