# ============================================================================
# STEPUP STORIES Mobile App — Environment Configuration (.env.example)
# Copy this file to `.env` inside `mobile/` before running `npx expo start`.
# IMPORTANT: NEVER place Razorpay secret keys or Firebase Admin private keys
# in this file! Payment secret keys belong ONLY in Server / Cloud Functions.
# ============================================================================

# 1. Website Backend Base URL (used for catalog sync & server-side payment endpoints)
EXPO_PUBLIC_API_BASE_URL=https://stepup-stories.vercel.app

# 2. Firebase Client SDK Public Configuration (Firebase Console -> Project Settings)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 3. Payment Mode Indicator ("test" by default until live Razorpay keys are configured on server)
EXPO_PUBLIC_PAYMENT_MODE=test
