rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default unless explicitly permitted below
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Approved Admin verification: requires custom claim `admin == true` OR
    // verified `role == 'admin'` in `admins/{uid}` (customers can never write to `admins/{uid}`)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidIndianAddress(addr) {
      return addr is map
        && addr.full_name is string && addr.full_name.size() >= 2
        && addr.phone is string && addr.phone.matches('^[6-9][0-9]{9}$')
        && addr.pincode is string && addr.pincode.matches('^[1-9][0-9]{5}$')
        && addr.address_line1 is string && addr.address_line1.size() >= 3
        && addr.city is string && addr.city.size() >= 2
        && addr.state is string && addr.state.size() >= 2;
    }

    // 0. Approved Admins Registry: Customers can NEVER create or modify admin roles
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if false; // Managed exclusively via Firebase Admin SDK / Server
    }

    // 1. Collections: Public read, Admin-only write
    match /collections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 2. Products: Public read, Admin-only write
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.price_amount is number
        && request.resource.data.price_amount > 0
        && request.resource.data.original_price_amount is number
        && request.resource.data.original_price_amount >= request.resource.data.price_amount
        && request.resource.data.brand_verified is bool
        && request.resource.data.stock_quantity is number
        && request.resource.data.stock_quantity >= 0;
      allow delete: if isAdmin();
    }

    // 3. Users: Users can read/update only their own customer profile and can NEVER set role to 'admin'
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer';
      allow update: if (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Wishlists: Signed-in users manage their own wishlist document
    match /wishlists/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 5. Orders:
    // - Clients can create a new order ONLY with `order_status == 'new'` and `payment_status == 'pending'`.
    //   Clients can NEVER mark an order as 'paid' directly (only server webhook/verification can).
    // - Customers can read only their own orders; approved admins can read and update all orders.
    match /orders/{orderId} {
      allow create: if isValidIndianAddress(request.resource.data.shipping_address)
        && request.resource.data.currency == 'INR'
        && request.resource.data.total_payable is number
        && request.resource.data.total_payable > 0
        && request.resource.data.payment_method in ['cod', 'razorpay']
        && request.resource.data.payment_status in ['pending', 'pending_cod', 'pending_online']
        && request.resource.data.status in ['new', 'placed'];

      allow get, list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 6. Admin Audit Logs: Append-only for approved admins; never editable or deletable
    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
